{
  "name": "melch-agentguard-worker",
  "version": "1.2.0",
  "description": "AgentGuard Cloudflare Worker payment and licensing backend",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:init": "wrangler d1 execute agentguard-db --local --file=./schema.sql",
    "d1:migrate": "wrangler d1 execute agentguard-db --remote --file=./schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240923.0",
    "typescript": "^5.5.4",
    "wrangler": "^3.78.0"
  }
}
